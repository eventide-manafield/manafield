# Copy this file to a private instance.yaml and customize it.
# Do not commit secrets here. Inject them through CI/runtime secret mechanisms.

version: 0

instance:
  id: manafield-local

core:
  source:
    repository: https://github.com/eventide-manafield/manafield.git
    ref: main

runtimeProviders:
  - id: docker
    enabled: true

modules:
  - id: manafield-reference
    enabled: true
    source:
      repository: https://github.com/eventide-manafield/manafield-module-reference.git
      ref: main
    build:
      type: docker
      context: .
      dockerfile: Dockerfile

    # Optional external Web exposure.
    exposure:
      type: host
      host: reference.example.test
      targetPort: 8080

deployment:
  # Internal Core <-> Module network.
  modulesNetwork: manafield-modules

  # Shared network used by externally exposed Modules and ingress infrastructure.
  edgeNetwork: manafield-edge

  # Optional ingress integration.
  ingress:
    provider: traefik

    # Generated dynamic configuration file.
    # Use a host path visible and writable by the CI executor.
    output: /path/to/traefik/dynamic/manafield.yml

    # Explicit bootstrap target. Manafield never auto-discovers a Traefik instance.
    bootstrap:
      composeFile: /path/to/traefik/docker-compose.yml
      service: traefik
