{
  "version": 0,
  "instanceId": "manafield-local",
  "core": {
    "source": {
      "repository": "https://github.com/eventide-manafield/manafield.git",
      "ref": "main"
    }
  },
  "runtimeProviders": [
    {
      "id": "docker"
    }
  ],
  "modules": [
    {
      "id": "manafield-reference",
      "source": {
        "repository": "https://github.com/eventide-manafield/manafield-module-reference.git",
        "ref": "main"
      },
      "build": {
        "type": "docker",
        "context": ".",
        "dockerfile": "Dockerfile"
      }
    }
  ],
  "deployment": {
    "modulesNetwork": "manafield-modules",
    "edgeNetwork": "manafield-edge"
  }
}
